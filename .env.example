# ============ 复制为 .env 后填写真实值 ============
# cp .env.example .env

# ---------- LLM（OpenAI 兼容接口） ----------
OPENAI_API_KEY=sk-your-key-here
# 兼容接口地址，DashScope / OpenAI / 本地网关均可
OPENAI_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen3.7-flash
EMBEDDING_MODEL=text-embedding-v3

# ---------- 搜索与数据源 ----------
TAVILY_API_KEY=your-tavily-key
BRIGHTDATA_API_KEY=your-brightdata-key
BRIGHTDATA_DATASET_ID=your-dataset-id

# ---------- MySQL ----------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-db-password
DB_NAME=competitor_analysis

# ---------- Redis ----------
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- 运行模式 ----------
# true: 走 Mock 工作流，不调用外部 API，适合本地跑通链路
# false: 真实调用 LLM / 搜索 / 抓取
MOCK_MODE=true

# ---------- 接口鉴权与跨域 ----------
# 留空则关闭 /api 鉴权（仅本机开发使用）
# 设置后必须与 frontend/.env 的 VITE_API_KEY 保持一致
API_KEY=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
